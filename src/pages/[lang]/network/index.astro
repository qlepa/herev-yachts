---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SectionLabel from '../../../components/ui/SectionLabel.astro';
import Btn from '../../../components/ui/Btn.astro';
import NetworkDirectory from '../../../islands/NetworkDirectory';
import type { NetworkLocation } from '../../../islands/NetworkDirectory';
import { getLocalePaths, LOCALES, type Locale } from '../../../lib/i18n';
import { loadTranslations } from '../../../lib/server/cms/uiStrings';
import { REGION_KEYS, regionOf } from '../../../lib/regions';
import rawLocations from '../../../data/locations.json';
import heroPic from '../../../assets/site/cannes-marina.avif';
import { staticPathProps } from '../../../lib/staticPaths';

export function getStaticPaths() {
  return getLocalePaths();
}

type LocationEntry = {
  id: string; name: string; city: string; country: string;
  address: string; lat: number; lng: number;
  brandKeys: string[]; dealerId?: string;
};

const { lang } = Astro.params as { lang: Locale };
// Rendered on demand on the CMS deployment, where getStaticPaths does not run.
if (!(await staticPathProps(Astro, getStaticPaths))) return new Response(null, { status: 404 });
const t = await loadTranslations(lang, Astro);
const np = t.networkPage;

function getDisplayName(locale: string, code: string): string {
  try {
    return new Intl.DisplayNames([locale], { type: 'region' }).of(code) ?? code;
  } catch {
    return code;
  }
}

// Brands (ordered, localised entry set — names are proper nouns)
const brandEntries = (await getCollection('brands', ({ id }) => id.startsWith(`${lang}/`)))
  .sort((a, b) => a.data.order - b.data.order);
const brands = brandEntries.map((b) => ({ key: b.data.brandKey, label: b.data.name }));

// Locations enriched at build time: localised country name, region, country-page anchor
const allLocations: NetworkLocation[] = (rawLocations as LocationEntry[]).map((l) => ({
  id: l.id,
  name: l.name,
  city: l.city,
  country: l.country,
  countryName: getDisplayName(lang, l.country),
  address: l.address,
  lat: l.lat,
  lng: l.lng,
  brandKeys: l.brandKeys,
  region: regionOf(l.country),
  href: `/${lang}/network/${l.country.toLowerCase()}/#loc-${l.id}`,
}));

const regions = REGION_KEYS.map((key) => ({ key, label: np.regions[key] }));

// Stats
const countryCodes = [...new Set(allLocations.map((l) => l.country))];
const continentsCount = new Set(allLocations.map((l) => l.region).filter((r) => r !== 'other')).size;
const heroStats = [
  { value: String(brands.length), label: np.stats.brands, icon: 'brands' },
  { value: String(allLocations.length), label: np.stats.dealers, icon: 'dealers' },
  { value: String(countryCodes.length), label: np.stats.countries, icon: 'countries' },
  { value: String(continentsCount), label: np.stats.continents, icon: 'continents' },
];

// Country directory (kept for SEO: every country page linked from here)
const byCountry = countryCodes
  .map((code) => {
    const locs = allLocations.filter((l) => l.country === code);
    return {
      displayName: locs[0]!.countryName,
      count: locs.length,
      cities: [...new Set(locs.map((l) => l.city))].slice(0, 2).join(' · '),
      href: `/${lang}/network/${code.toLowerCase()}/`,
    };
  })
  .sort((a, b) => b.count - a.count);

const alternates = LOCALES.map((l) => ({ lang: l, href: `https://herev.com/${l}/network/` }));
const pageTitle = `${np.hero.heading} ${Astro.locals.siteSettings.titleSuffix}`;
const pageDescription = np.hero.subtext;
---

<Layout lang={lang} title={pageTitle} description={pageDescription} alternates={alternates}>
  <SiteHeader lang={lang} variant="ink" currentPath={`/${lang}/network/`} nav={t.nav} />

  <main>

    <!-- 1. HERO -->
    <section class="relative bg-ink text-white overflow-hidden">
      <Image
        src={heroPic}
        alt=""
        widths={[800, 1440]}
        sizes="100vw"
        loading="eager"
        class="absolute inset-0 w-full h-full object-cover opacity-20 pointer-events-none"
        aria-hidden="true"
      />
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: linear-gradient(90deg, var(--color-ink) 35%, rgba(15,37,46,.55) 100%);"
        aria-hidden="true"
      />
      <div class="relative max-w-[1440px] mx-auto px-gutter pt-8 pb-14">
        <nav aria-label="Breadcrumb" class="mb-8">
          <p class="font-mono text-micro tracking-mono text-[var(--color-paper-72)] uppercase m-0">
            <a href={`/${lang}/`} class="hover:text-gilt transition-colors">{np.hero.breadcrumbHome}</a>
            {' / '}
            <span class="text-white">{np.hero.heading}</span>
          </p>
        </nav>
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-10 lg:gap-16 items-center">
          <div>
            <SectionLabel text={np.hero.eyebrow} on="ink" class="mb-5" />
            <h1
              class="font-display text-white uppercase leading-tight mb-5"
              style="font-size: clamp(1.9rem, 3.6vw, 2.9rem); font-weight: 400; letter-spacing: .14em;"
            >
              {np.hero.heading}
            </h1>
            <p class="text-[var(--color-paper-72)] text-body leading-relaxed max-w-[560px] m-0">
              {np.hero.subtext}
            </p>
          </div>
          <!-- Stats -->
          <div class="grid grid-cols-2 sm:grid-cols-4 lg:flex">
            {heroStats.map((stat) => (
              <div class="flex flex-col items-center text-center gap-2 px-6 py-4 border-l border-[var(--color-line-on-ink)] first:border-l-0 lg:min-w-[120px]">
                <svg
                  width="26" height="26" viewBox="0 0 24 24" fill="none"
                  stroke="var(--color-gilt)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {stat.icon === 'brands' && (
                    <><path d="M3 17h18l-2 3H5z" /><path d="M5 17V9l7-6 7 6v8" /><path d="M9 17v-4h6v4" /></>
                  )}
                  {stat.icon === 'dealers' && (
                    <><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" /></>
                  )}
                  {stat.icon === 'countries' && (
                    <><circle cx="12" cy="12" r="9" /><path d="m15 9-2 6-4 0 2-6z" /><circle cx="12" cy="12" r="1" /></>
                  )}
                  {stat.icon === 'continents' && (
                    <><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="3" /><path d="M12 3v6M12 15v6M3 12h6M15 12h6M5.6 5.6l4.3 4.3M14.1 14.1l4.3 4.3M5.6 18.4l4.3-4.3M14.1 9.9l4.3-4.3" /></>
                  )}
                </svg>
                <span class="font-display text-gilt leading-none" style="font-size: 2rem; font-weight: 400;">{stat.value}</span>
                <span class="font-mono text-micro tracking-mono text-[var(--color-paper-72)] uppercase">{stat.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. MAP + FILTERS + DEALER LIST (island) -->
    <section class="bg-paper py-10">
      <div class="max-w-[1440px] mx-auto px-gutter">
        <NetworkDirectory
          client:visible
          locations={allLocations}
          brands={brands}
          regions={regions}
          accessToken={import.meta.env.PUBLIC_MAPBOX_TOKEN ?? ''}
          lang={lang}
          t={np.explorer}
        />
      </div>
    </section>

    <!-- 3. COUNTRY DIRECTORY -->
    <section id="directory" class="bg-paper pb-section">
      <div class="max-w-[1440px] mx-auto px-gutter">
        <div class="bg-white border border-[var(--color-line)] rounded-soft p-5 md:p-7">
          <SectionLabel text={`${np.directory.eyebrow} · ${countryCodes.length} ${np.stats.countries}`} class="mb-3" />
          <h2
            class="font-display text-ink leading-tight tracking-tight mb-6"
            style="font-size: clamp(1.375rem, 2.5vw, 1.75rem); font-weight: 400;"
          >
            {np.directory.heading}
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-[var(--color-line)] border border-[var(--color-line)]">
            {byCountry.map((country) => (
              <a
                href={country.href}
                class="bg-white px-5 py-4 flex items-center justify-between gap-3 hover:bg-paper transition-colors"
              >
                <div class="flex flex-col gap-1 min-w-0">
                  <span class="font-display text-ink leading-tight truncate" style="font-size: 1.0625rem; font-weight: 450;">
                    {country.displayName}
                  </span>
                  <span class="font-mono text-micro tracking-mono text-[var(--color-ink-55)] uppercase truncate">
                    {country.cities}
                  </span>
                </div>
                <span class="font-mono font-bold text-brass shrink-0" style="font-size: 15px;">{country.count}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. OUR BRANDS -->
    <section class="bg-white border-t border-[var(--color-line)] py-10">
      <div class="max-w-[1440px] mx-auto px-gutter flex flex-col md:flex-row md:items-center gap-8">
        <p class="font-mono font-semibold text-[12px] tracking-mono text-ink uppercase m-0 shrink-0">
          {np.brandsStrip.title}
        </p>
        <ul class="flex flex-wrap items-center justify-start md:justify-around gap-x-10 gap-y-4 flex-1 m-0 p-0 list-none">
          {brands.map((b) => (
            <li>
              <a
                href={`/${lang}/brands/${b.key}/`}
                class="font-display text-ink hover:text-teal transition-colors uppercase"
                style="font-size: 1.375rem; font-weight: 380; letter-spacing: .2em;"
              >
                {b.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. CTA BAND -->
    <section id="enquire" class="bg-ink text-white py-12">
      <div class="max-w-[1440px] mx-auto px-gutter grid grid-cols-1 lg:grid-cols-[1fr_1fr_auto] gap-8 items-center">
        <div>
          <SectionLabel text={np.cta.eyebrow} on="ink" class="mb-3" />
          <h2
            class="font-display text-white uppercase leading-tight m-0"
            style="font-size: clamp(1.25rem, 2.2vw, 1.75rem); font-weight: 400; letter-spacing: .12em;"
          >
            {np.cta.heading}
          </h2>
        </div>
        <p class="text-[var(--color-paper-72)] text-body leading-relaxed m-0 lg:border-l lg:border-[var(--color-line-on-ink)] lg:pl-8">
          {np.cta.subtext}
        </p>
        <Btn variant="gilt" href={`/${lang}/#lead`}>{np.cta.ctaLabel}</Btn>
      </div>
    </section>

  </main>

  <SiteFooter lang={lang} t={t.footer} />
</Layout>
