---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Btn from '../../components/ui/Btn.astro';
import { getLocalePaths, type Locale } from '../../lib/i18n';
import { getTranslations } from '../../lib/i18n-strings';

export function getStaticPaths() {
  return getLocalePaths();
}

const { lang } = Astro.params as { lang: Locale };
const t = getTranslations(lang);
---

<Layout lang={lang} title="404 — Herev" noindex={true} alternates={[]}>

  <SiteHeader
    lang={lang}
    variant="ink"
    currentPath=""
    nav={t.nav}
  />

  <main class="min-h-[60vh] flex items-center bg-paper">
    <div class="max-w-[1440px] mx-auto px-gutter py-section text-center w-full">
      <p
        class="font-display text-ink leading-none mb-6 select-none"
        aria-hidden="true"
        style="font-size: clamp(6rem, 20vw, 14rem); font-weight: 400; opacity: 0.07;"
      >
        404
      </p>
      <h1
        class="font-display text-h2 text-ink mb-4"
        style="font-weight: 400;"
      >
        {t.notFound.heading}
      </h1>
      <p class="text-body text-[var(--color-ink-70)] leading-relaxed mb-8 max-w-[420px] mx-auto">
        {t.notFound.subtext}
      </p>
      <Btn variant="ink" href={`/${lang}/`}>
        {t.notFound.backToHome}
      </Btn>
    </div>
  </main>

  <SiteFooter lang={lang} t={t.footer} />

</Layout>
