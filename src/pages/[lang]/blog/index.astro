---
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SectionLabel from '../../../components/ui/SectionLabel.astro';
import { getLocalePaths, LOCALES, type Locale } from '../../../lib/i18n';
import { getTranslations } from '../../../lib/i18n-strings';
import { listBlogPosts } from '../../../lib/server/sanity';
import { urlForImage, srcsetForImage } from '../../../lib/sanityImage';

export function getStaticPaths() {
  return getLocalePaths();
}

const { lang } = Astro.params as { lang: Locale };
const t = getTranslations(lang);

const allPosts = await listBlogPosts(lang);

const posts = allPosts.map((post) => ({
  ...post,
  href: `/${lang}/blog/${post.slug}/`,
}));

const alternates = LOCALES.map((l) => ({ lang: l, href: `/${l}/blog/` }));
const pageTitle = `${t.blogPage.heading} — Herev`;
---

<Layout
  lang={lang}
  title={pageTitle}
  description={t.blogPage.subheading}
  alternates={alternates}
>
  <SiteHeader lang={lang} variant="ink" currentPath={`/${lang}/blog/`} nav={t.nav} />

  <main>
    <section class="py-section bg-paper">
      <div class="max-w-[1440px] mx-auto px-gutter">

        <SectionLabel text={t.blogPage.eyebrow} class="mb-4" />
        <h1
          class="font-display text-h1 text-ink mb-4 max-w-[640px]"
          style="font-weight: 400; letter-spacing: var(--tracking-tight);"
        >
          {t.blogPage.heading}
        </h1>
        <p class="text-body text-[var(--color-ink-70)] leading-relaxed max-w-[520px] mb-14">
          {t.blogPage.subheading}
        </p>

        {posts.length === 0 ? (
          <p class="text-body text-[var(--color-ink-55)]">{t.blogPage.comingSoon}</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {posts.map((post) => (
              <a
                href={post.href}
                class="group block border border-[var(--color-line)] hover:border-[var(--color-ink)] transition-colors duration-200 bg-white overflow-hidden"
              >
                {post.image && (
                  <img
                    src={urlForImage(post.image).width(768).auto('format').url()}
                    srcset={srcsetForImage(post.image)}
                    sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                    alt={post.image.alt ?? ''}
                    loading="lazy"
                    class="w-full aspect-[3/2] object-cover"
                  />
                )}
                <div class="p-8">
                  {post.category && (
                    <p class="text-label font-body tracking-[var(--tracking-label)] text-teal mb-4 uppercase">
                      {post.category}
                    </p>
                  )}
                  <h2
                    class="font-display text-h3 text-ink mb-3 group-hover:text-teal transition-colors duration-200"
                    style="font-weight: 400; letter-spacing: var(--tracking-tight); line-height: 1.15;"
                  >
                    {post.title}
                  </h2>
                  <p class="text-sm text-[var(--color-ink-70)] leading-relaxed mb-6">
                    {post.excerpt}
                  </p>
                  <div class="flex items-end justify-between gap-4">
                    <span class="text-label text-[var(--color-ink-55)] tracking-[var(--tracking-label)] uppercase">
                      {new Date(post.publishedAt).toLocaleDateString(lang, {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </span>
                    <span class="text-sm text-teal shrink-0">{t.blogPage.readMore}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}

      </div>
    </section>
  </main>

  <SiteFooter lang={lang} t={t.footer} />
</Layout>
