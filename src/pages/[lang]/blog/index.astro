---
import BlogListing from '../../../components/BlogListing.astro';
import { getLocalePaths, LOCALES, type Locale } from '../../../lib/i18n';
import { listBlogPage } from '../../../lib/server/cms/blog';

export function getStaticPaths() {
  return getLocalePaths();
}

const { lang } = Astro.params as { lang: Locale };
// Rendered on demand on the CMS deployment, where getStaticPaths does not run.
if (!LOCALES.includes(lang)) return new Response(null, { status: 404 });

const { posts, totalPages } = await listBlogPage(lang, 1, Astro.locals.draftMode === true);
// The first listing page exists in every language (empty = "coming soon").
const alternates = LOCALES.map((l) => ({ lang: l, href: `/${l}/blog/` }));
---

<BlogListing lang={lang} page={1} totalPages={totalPages} posts={posts} alternates={alternates} />
