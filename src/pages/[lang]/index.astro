---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import IntroSection from '../../components/sections/IntroSection.astro';
import StockStrip from '../../components/sections/StockStrip.astro';
import AdvisorySplit from '../../components/sections/AdvisorySplit.astro';
import GuideCapture from '../../components/sections/GuideCapture.astro';
import ShipyardsSection from '../../components/sections/ShipyardsSection.astro';
import StatementSection from '../../components/sections/StatementSection.astro';
import LeadModule from '../../components/sections/LeadModule.astro';
import NetworkTeaser from '../../components/sections/NetworkTeaser.astro';
import MobileCta from '../../components/ui/MobileCta.astro';
import { getLocalePaths, type Locale } from '../../lib/i18n';
import { loadTranslations } from '../../lib/server/cms/uiStrings';
import { getYachtHero, getBrandHero } from '../../lib/images';
import { getStockEntries, toStockCards } from '../../lib/stock';
import locations from '../../data/locations.json';
import homepageHero from '../../assets/site/homepage-hero.jpeg';
import marinaPic from '../../assets/site/cannes-marina.avif';
import leadPic from '../../assets/site/lead-image.avif';
import { staticPathProps } from '../../lib/staticPaths';

export function getStaticPaths() {
  return getLocalePaths();
}

const { lang } = Astro.params as { lang: Locale };
// Rendered on demand on the CMS deployment, where getStaticPaths does not run.
if (!(await staticPathProps(Astro, getStaticPaths))) return new Response(null, { status: 404 });
const t = await loadTranslations(lang, Astro);

const brandDisplayMap: Record<string, string> = {
  galeon:       'GALEON',
  parker:       'PARKER',
  saxdor:       'SAXDOR',
  'de-antonio': 'DE ANTONIO',
  'chris-craft': 'CHRIS-CRAFT',
};

const brandOrder: Record<string, number> = {
  galeon: 1, parker: 2, saxdor: 3, 'de-antonio': 4, 'chris-craft': 5,
};

const allYachts = await getCollection(
  'yachts',
  (e) => e.id.startsWith(`${lang}/`) && !e.data.draft,
);
const sortedBrandNames = Object.entries(brandOrder)
  .sort(([, a], [, b]) => a - b)
  .map(([key]) => brandDisplayMap[key]);

const allModelNames = [
  ...sortedBrandNames,
  ...allYachts
    .sort((a, b) => (brandOrder[a.data.brand] ?? 9) - (brandOrder[b.data.brand] ?? 9))
    .map((y) => `${brandDisplayMap[y.data.brand] ?? y.data.brand.toUpperCase()} ${y.data.name}`),
];

const stockUnits = (await toStockCards(await getStockEntries(lang), lang, t)).slice(0, 3);

const countryCount = new Set(locations.map((l) => l.country)).size;

const brandTiles = await Promise.all(
  Object.keys(brandOrder).map(async (key) => ({
    name:  brandDisplayMap[key],
    href:  `/${lang}/yachts/${key}/`,
    image: await getBrandHero(key),
  })),
);

const advisePic    = await getYachtHero('galeon-500-fly', false);
const representPic = await getYachtHero('saxdor-400-gtc', false);

let heroPosterSrc: string | undefined;
try {
  const oembedRes = await fetch('https://vimeo.com/api/oembed.json?url=https://vimeo.com/1185484138&width=1920');
  if (oembedRes.ok) {
    const oembedData = await oembedRes.json() as { thumbnail_url?: string };
    heroPosterSrc = oembedData.thumbnail_url;
  }
} catch {
  // fall through — HeroSection will use the static image fallback
}

const networkStats = [
  { value: String(countryCount), label: t.network.countries },
  { value: '30+',                label: t.network.berths },
  { value: '60+',                label: t.network.models },
];
---

<Layout lang={lang} title={t.meta.title} description={t.meta.description}>

  <SiteHeader
    lang={lang}
    variant="transparent"
    currentPath={`/${lang}/`}
    nav={t.nav}
  />

  <main>

    <HeroSection
      fullscreen
      image={homepageHero}
      imageAlt="A Saxdor yacht under way on open water"
      videoSrc="https://player.vimeo.com/progressive_redirect/playback/1185484138/rendition/1080p/file.mp4%20%281080p%29.mp4?loc=external&oauth2_token_id=1799510047&signature=85041f5fdc32ddad1d3e0c1bfe3c7f45a2ad09386863675518639a098fb22027"
      posterSrc={heroPosterSrc}
      heading={t.hero.heading}
      subtext={t.hero.subtext}
      cta1Label={t.hero.cta1}
      cta1Href="#lead"
      cta2Label={t.hero.cta2}
      cta2Href={`/${lang}/yachts/`}
    />

    <div class="relative z-[1]">

    <IntroSection
      eyebrow={t.intro.eyebrow}
      heading={t.intro.heading}
      body={t.intro.body}
      stats={[
        { value: '5',  label: t.intro.statLabels.ateliers },
        { value: '17', label: t.intro.statLabels.years },
        { value: '1',  label: t.intro.statLabels.relationship },
      ]}
    />

    <AdvisorySplit
      blocks={[
        {
          heading:  t.advisory.advise.heading,
          bullets:  t.advisory.advise.bullets,
          image:    advisePic,
          imageAlt: 'Galeon flybridge yacht under way',
        },
        {
          heading:  t.advisory.represent.heading,
          bullets:  t.advisory.represent.bullets,
          image:    representPic,
          imageAlt: 'Saxdor yacht at speed on open water',
        },
      ]}
    />

    <GuideCapture
      heading={t.guide.heading}
      body={t.guide.body}
      emailPlaceholder={t.guide.emailPlaceholder}
      ctaLabel={t.guide.cta}
    />

    <ShipyardsSection
      eyebrow={t.shipyards.eyebrow}
      heading={t.shipyards.heading}
      body={t.shipyards.body}
      image={homepageHero}
      imageAlt="Yachts running in formation along the coast"
      brands={brandTiles}
    />

    <StatementSection
      headingLine1={t.statement.headingLine1}
      headingLine2={t.statement.headingLine2}
      body={t.statement.body}
    />

    <NetworkTeaser
      eyebrow={t.network.eyebrow}
      heading={t.network.heading}
      body={t.network.body}
      stats={networkStats}
      image={marinaPic}
      imageAlt="Marina with yachts at sunset"
      imageCaption={t.network.imageCaption}
      linkLabel={t.network.linkLabel}
      linkHref={`/${lang}/network/`}
    />

    <StockStrip
      units={stockUnits}
      eyebrow={t.stock.eyebrow}
      heading={t.stock.heading}
      subheading={t.stock.subheading}
      viewAllLabel={t.stock.viewAll}
      viewAllHref={`/${lang}/available-now/`}
      enquireLabel={t.stock.enquire}
      moreInfoLabel={t.stock.moreInfo}
    />

    <LeadModule
      eyebrow={t.lead.eyebrow}
      heading={t.lead.heading}
      subtext={t.lead.subtext}
      ctaLabel={t.lead.cta}
      image={leadPic}
      imageAlt="Galeon yacht cockpit interior"
      orCallLabel={t.lead.orCall}
      fallbackContact={Astro.locals.siteSettings.email}
      callNumber={Astro.locals.siteSettings.phone}
      namePlaceholder={t.lead.namePlaceholder}
      contactPlaceholder={t.lead.contactPlaceholder}
      modelPlaceholder={t.lead.modelPlaceholder}
      messagePlaceholder={t.lead.messagePlaceholder}
      models={allModelNames}
    />

    </div>

  </main>

  <SiteFooter lang={lang} t={t.footer} />

  <MobileCta enquireLabel={t.yachtPage.mobileCta.enquire} />

</Layout>
