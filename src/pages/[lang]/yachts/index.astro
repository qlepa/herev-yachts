---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SectionLabel from '../../../components/ui/SectionLabel.astro';
import FleetCard from '../../../components/FleetCard.astro';
import { getLocalePaths, type Locale } from '../../../lib/i18n';
import type { BrandKey, CategoryKey } from '../../../content.config';
import { getTranslations } from '../../../lib/i18n-strings';
import { getYachtHero } from '../../../lib/images';
import { metresToFeet } from '../../../lib/format';

export function getStaticPaths() {
  return getLocalePaths();
}

const { lang } = Astro.params as { lang: Locale };
const t = getTranslations(lang);

const brandOrder: Record<BrandKey, number> = {
  galeon: 1, parker: 2, saxdor: 3, 'de-antonio': 4, 'chris-craft': 5,
};

const brandDisplayMap: Record<BrandKey, string> = {
  galeon:       'GALEON',
  parker:       'PARKER',
  saxdor:       'SAXDOR',
  'de-antonio': 'DE ANTONIO',
  'chris-craft': 'CHRIS-CRAFT',
};

const yachtEntries = await getCollection(
  'yachts',
  (e) => e.id.startsWith(`${lang}/`) && !e.data.draft,
);

yachtEntries.sort((a, b) => {
  const brandDiff =
    (brandOrder[a.data.brand as BrandKey] ?? 9) -
    (brandOrder[b.data.brand as BrandKey] ?? 9);
  if (brandDiff !== 0) return brandDiff;
  return a.data.lengthM - b.data.lengthM;
});

const yachtCards = await Promise.all(
  yachtEntries.map(async (y) => ({
    translationKey: y.data.translationKey,
    name:           y.data.name,
    brandDisplay:   brandDisplayMap[y.data.brand as BrandKey] ?? y.data.brand.toUpperCase(),
    loaM:           y.data.lengthM,
    loaFt:          metresToFeet(y.data.lengthM),
    categoryLabel:  y.data.category
      ? t.categories[y.data.category as CategoryKey]
      : undefined,
    image:          await getYachtHero(y.data.translationKey, y.data.draft),
    href:           `/${lang}/yachts/${y.data.translationKey}/`,
  })),
);

const pageTitle = t.yachtsPage.heading + ' — Herev';
const pageDescription = t.yachtsPage.subheading;
---

<Layout lang={lang} title={pageTitle} description={pageDescription}>

  <SiteHeader
    lang={lang}
    variant="ink"
    currentPath={`/${lang}/yachts/`}
    nav={t.nav}
  />

  <main>

    <!-- Page header -->
    <section class="bg-paper pt-14 pb-10">
      <div class="max-w-[1440px] mx-auto px-gutter">
        <SectionLabel text="THE FULL COLLECTION" class="mb-4" />
        <h1
          class="font-display text-h1 text-ink mb-4 max-w-[640px]"
          style="font-weight: 400; letter-spacing: var(--tracking-tight);"
        >
          {t.yachtsPage.heading}
        </h1>
        <p class="text-body text-[var(--color-ink-70)] leading-relaxed max-w-[480px]">
          {t.yachtsPage.subheading}
        </p>
      </div>
    </section>

    <!-- Fleet grid -->
    <section class="py-section bg-paper">
      <div class="max-w-[1440px] mx-auto px-gutter">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {yachtCards.map((yacht) => (
            <FleetCard
              name={yacht.name}
              brandDisplay={yacht.brandDisplay}
              loaM={yacht.loaM}
              loaFt={yacht.loaFt}
              categoryLabel={yacht.categoryLabel}
              image={yacht.image}
              href={yacht.href}
              enquireLabel={t.fleet.enquire}
            />
          ))}
        </div>
      </div>
    </section>

  </main>

  <SiteFooter lang={lang} t={t.footer} />

</Layout>
