---
import { getCollection, render } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import HeroSection from '../../../../components/sections/HeroSection.astro';
import YachtKeyFacts from '../../../../components/sections/YachtKeyFacts.astro';
import YachtOverview from '../../../../components/sections/YachtOverview.astro';
import YachtFeatures from '../../../../components/sections/YachtFeatures.astro';
import YachtLifestyle from '../../../../components/sections/YachtLifestyle.astro';
import YachtSpaces from '../../../../components/sections/YachtSpaces.astro';
import YachtVideo from '../../../../components/sections/YachtVideo.astro';
import YachtDeckPlans from '../../../../components/sections/YachtDeckPlans.astro';
import YachtSpecs from '../../../../components/sections/YachtSpecs.astro';
import YachtGallery from '../../../../components/sections/YachtGallery.astro';
import YachtCompare from '../../../../components/sections/YachtCompare.astro';
import YachtFinancing from '../../../../components/sections/YachtFinancing.astro';
import RecommendedYachts from '../../../../components/sections/RecommendedYachts.astro';
import YachtLeadModule from '../../../../components/sections/YachtLeadModule.astro';
import MobileCta from '../../../../components/ui/MobileCta.astro';
import { LOCALES, type Locale } from '../../../../lib/i18n';
import type { BrandKey, CategoryKey } from '../../../../content.config';
import { loadTranslations } from '../../../../lib/server/cms/uiStrings';
import {
  getYachtHero,
  getYachtGallery,
  getYachtLayouts,
  getYachtFeatureImages,
  getYachtSpaceImages,
  getYachtBrochure,
} from '../../../../lib/images';
import { parseVideoUrl } from '../../../../lib/video';
import { metresToFeet } from '../../../../lib/format';
import leadPic from '../../../../assets/site/lead-image.avif';
import { staticPathProps } from '../../../../lib/staticPaths';

export async function getStaticPaths() {
  const allYachts = await getCollection('yachts', (e) => !e.data.draft);
  const paths = [];
  for (const lang of LOCALES) {
    const langYachts = allYachts.filter((e) => e.id.startsWith(`${lang}/`));
    for (const entry of langYachts) {
      paths.push({ params: { lang, brand: entry.data.brand, yacht: entry.data.translationKey } });
    }
  }
  return paths;
}

const { lang, brand, yacht: yachtSlug } = Astro.params as { lang: Locale; brand: string; yacht: string };
// Rendered on demand on the CMS deployment, where getStaticPaths does not run.
if (!(await staticPathProps(Astro, getStaticPaths))) return new Response(null, { status: 404 });
const t = await loadTranslations(lang, Astro);
const tp = t.yachtPage;

const brandDisplayMap: Record<BrandKey, string> = {
  galeon:        'GALEON',
  parker:        'PARKER',
  saxdor:        'SAXDOR',
  'de-antonio':  'DE ANTONIO',
  'chris-craft': 'CHRIS-CRAFT',
};

const allLangYachts = await getCollection(
  'yachts',
  (e) => e.id.startsWith(`${lang}/`) && !e.data.draft,
);

const yachtEntry = allLangYachts.find((e) => e.data.translationKey === yachtSlug);
if (!yachtEntry) return Astro.redirect(`/${lang}/yachts/`);

const { Content } = await render(yachtEntry);
const data = yachtEntry.data;
const brandDisplay = brandDisplayMap[data.brand as BrandKey] ?? data.brand.toUpperCase();
const fullName = `${brandDisplay} ${data.name}`;
const categoryLabel = data.category ? t.categories[data.category as CategoryKey] : undefined;
const withName = (s: string) => s.replace('{name}', data.name).replace('{brand}', brandDisplay);

// --- Media -----------------------------------------------------------------
const heroImage = await getYachtHero(data.translationKey, data.draft);
const galleryImages = await getYachtGallery(data.translationKey);
const layoutImages = await getYachtLayouts(data.translationKey);
const featureImages = await getYachtFeatureImages(data.translationKey);
const spaceImages = await getYachtSpaceImages(data.translationKey);
const brochureHref = await getYachtBrochure(data.translationKey);

const galleryByCat = (cat: string) => galleryImages.find((g) => g.category === cat)?.src;
const overviewImage = galleryByCat('exterior') ?? galleryImages[0]?.src ?? heroImage;
const lifestyleImage = galleryByCat('lifestyle') ?? galleryByCat('exterior') ?? heroImage;
const leadImage = galleryByCat('cockpit') ?? galleryImages[0]?.src ?? leadPic;

const video = data.video ? parseVideoUrl(data.video.url) : null;
if (data.video && !video) {
  throw new Error(
    `[herev] Unsupported video URL for "${data.translationKey}": ${data.video.url}. Use a YouTube or Vimeo page URL.`,
  );
}
// Vimeo has no static poster URL — resolve one at build time via oEmbed
// (same approach as the homepage hero). On failure the play button sits on ink.
if (video && !video.posterUrl) {
  try {
    const res = await fetch(
      `https://vimeo.com/api/oembed.json?url=${encodeURIComponent(data.video!.url)}&width=1280`,
    );
    if (res.ok) video.posterUrl = ((await res.json()) as { thumbnail_url?: string }).thumbnail_url;
  } catch {
    // keep posterUrl undefined
  }
}

// --- Hero ------------------------------------------------------------------
const specLine = categoryLabel ? `${categoryLabel} · ${data.lengthM} M` : `${data.lengthM} M`;

const keyFacts = [
  { icon: 'length' as const, value: `${data.lengthM} m`, label: tp.keyNumbers.length },
  { icon: 'cabins' as const, value: String(data.cabins), label: tp.keyNumbers.cabins },
  ...(data.berths !== undefined
    ? [{ icon: 'guests' as const, value: String(data.berths), label: tp.keyNumbers.guests }]
    : []),
  ...(data.maxSpeedKn !== undefined
    ? [{ icon: 'speed' as const, value: `${data.maxSpeedKn} kn`, label: tp.keyNumbers.speed }]
    : []),
];

// --- Compare the range (same brand, build-time) -----------------------------
const compareRows = allLangYachts
  .filter((e) => e.data.brand === data.brand)
  .sort((a, b) => a.data.lengthM - b.data.lengthM)
  .map((e) => ({
    name:       e.data.name,
    href:       `/${lang}/yachts/${e.data.brand}/${e.data.translationKey}/`,
    lengthM:    e.data.lengthM,
    cabins:     e.data.cabins,
    berths:     e.data.berths,
    maxSpeedKn: e.data.maxSpeedKn,
    current:    e.data.translationKey === data.translationKey,
  }));

// --- Recommended (other brands, similar category / length) -----------------
const otherYachts = allLangYachts.filter(
  (e) => e.data.translationKey !== data.translationKey && e.data.brand !== data.brand,
);
otherYachts.sort((a, b) => {
  const aCat = a.data.category === data.category ? 0 : 1;
  const bCat = b.data.category === data.category ? 0 : 1;
  if (aCat !== bCat) return aCat - bCat;
  return Math.abs(a.data.lengthM - data.lengthM) - Math.abs(b.data.lengthM - data.lengthM);
});

const recommendedCards = await Promise.all(
  otherYachts.slice(0, 3).map(async (y) => ({
    translationKey: y.data.translationKey,
    name:           y.data.name,
    brandDisplay:   brandDisplayMap[y.data.brand as BrandKey] ?? y.data.brand.toUpperCase(),
    loaM:           y.data.lengthM,
    loaFt:          metresToFeet(y.data.lengthM),
    categoryLabel:  y.data.category ? t.categories[y.data.category as CategoryKey] : undefined,
    image:          await getYachtHero(y.data.translationKey, y.data.draft),
    href:           `/${lang}/yachts/${y.data.brand}/${y.data.translationKey}/`,
  })),
);

// --- SEO -------------------------------------------------------------------
const alternates = LOCALES.map((l) => ({ lang: l, href: `/${l}/yachts/${brand}/${yachtSlug}/` }));
const seoTitle       = data.seo?.title       ?? `${fullName} — Herev`;
const seoDescription = data.seo?.description ?? data.tagline ?? `${fullName}, ${data.lengthM}m.`;
---

<Layout lang={lang} title={seoTitle} description={seoDescription} alternates={alternates}>

  <SiteHeader
    lang={lang}
    variant="ink"
    currentPath={`/${lang}/yachts/${brand}/${yachtSlug}/`}
    nav={t.nav}
  />

  <main>

    <!-- 01 Hero -->
    {heroImage && (
      <HeroSection
        eyebrow={brandDisplay}
        heading={data.name}
        subtext={data.tagline}
        specLine={specLine}
        cta1Label={tp.enquireCta}
        cta1Href="#lead"
        cta2Label={tp.bookViewingCta}
        cta2Href="#lead"
        cta3Label={brochureHref ? tp.brochureCta : undefined}
        cta3Href={brochureHref}
        image={heroImage}
        imageAlt={`${data.name} yacht`}
      />
    )}

    <YachtKeyFacts facts={keyFacts} />

    <!-- 02 Why choose -->
    <YachtOverview
      label={withName(tp.whyLabel)}
      image={overviewImage}
      yachtName={fullName}
      enquireLabel={tp.enquireCta}
      enquireHref="#lead"
    >
      <Content />
    </YachtOverview>

    <!-- 03 Signature features -->
    <YachtFeatures
      eyebrow={tp.features.eyebrow}
      heading={tp.features.heading}
      features={data.features ?? []}
      images={featureImages}
      yachtName={fullName}
    />

    <!-- 04 Lifestyle -->
    {data.lifestyle && lifestyleImage && (
      <YachtLifestyle
        eyebrow={withName(tp.lifestyle.eyebrow)}
        heading={data.lifestyle.heading ?? tp.lifestyle.heading}
        pillars={data.lifestyle.pillars}
        image={lifestyleImage}
        yachtName={fullName}
      />
    )}

    <!-- 05 Interior spaces -->
    <YachtSpaces
      eyebrow={tp.spacesEyebrow}
      spaces={data.spaces ?? []}
      images={spaceImages}
      yachtName={fullName}
    />

    <!-- 06 Video -->
    {video && (
      <YachtVideo
        eyebrow={tp.video.eyebrow}
        heading={withName(tp.video.heading)}
        video={video}
        caption={data.video?.caption}
        playLabel={tp.video.play}
      />
    )}

    <!-- 07 Deck plans -->
    <YachtDeckPlans
      images={layoutImages}
      titles={data.layouts}
      fallbackPrefix={tp.deckFallback}
      eyebrow={tp.deckPlansHeading}
      subtitle={tp.deckPlansSubtitle}
      viewFullSizeLabel={tp.viewFullSize}
      yachtName={fullName}
    />

    <!-- 08 Specifications -->
    <YachtSpecs
      eyebrow={tp.specsEyebrow}
      subtitle={tp.specsSubtitle}
      groups={tp.specsGroups}
      labels={tp.specs}
      lengthM={data.lengthM}
      beamM={data.beamM}
      draftM={data.draftM}
      cabins={data.cabins}
      berths={data.berths}
      engines={data.engines}
      maxSpeedKn={data.maxSpeedKn}
      cruiseSpeedKn={data.cruiseSpeedKn}
      fuelL={data.fuelL}
      waterL={data.waterL}
      ceCategory={data.ceCategory}
      year={data.year}
    />

    <!-- 09 Gallery -->
    <YachtGallery
      images={galleryImages}
      eyebrow={tp.galleryHeading}
      titlePrefix={tp.galleryTitle}
      yachtName={fullName}
      allLabel={tp.galleryAll}
      categoryLabels={tp.galleryCategories}
      imagesLabel={tp.galleryImages}
    />

    <!-- 10 Compare the range -->
    <YachtCompare
      eyebrow={tp.compare.eyebrow}
      heading={withName(tp.compare.heading)}
      columns={tp.compare}
      currentLabel={tp.compare.current}
      rows={compareRows}
    />

    <YachtFinancing
      eyebrow={tp.financing.eyebrow}
      copy={tp.financing.copy}
      ctaLabel={tp.financing.cta}
    />

    <RecommendedYachts
      heading={tp.recommendedHeading}
      eyebrow={tp.recommendedEyebrow}
      viewAllLabel={tp.viewAllLabel}
      viewAllHref={`/${lang}/yachts/`}
      yachts={recommendedCards}
      enquireLabel={t.fleet.enquire}
    />

    <!-- 11 Ready to experience — lead form -->
    <YachtLeadModule
      eyebrow={tp.leadEyebrow}
      heading={withName(tp.readyHeading)}
      brandLine={`AUTHORISED ${brandDisplay} REPRESENTATIVE`}
      ctaLabel={tp.sendEnquiry}
      image={leadImage}
      imageAlt={`${data.name} yacht`}
      fallbackContact={t.lead.fallbackContact}
      orCallLabel={t.lead.orCall}
      namePlaceholder={t.lead.namePlaceholder}
      emailPlaceholder={tp.emailPlaceholder}
      phonePlaceholder={tp.phonePlaceholder}
      modelValue={fullName}
      messagePlaceholder={t.lead.messagePlaceholder}
      financingLabel={tp.financingCheckbox}
      privacyLabel={tp.privacyCheckbox}
      brochureHref={brochureHref}
      brochureLabel={tp.brochureCta}
    />

    <MobileCta enquireLabel={tp.mobileCta.enquire} />

  </main>

  <SiteFooter lang={lang} t={t.footer} />

</Layout>
