---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Bullet {
  lead: string;
  rest: string;
}

interface Block {
  heading: string;
  bullets: Bullet[];
  image: ImageMetadata | null;
  imageAlt: string;
}

interface Props {
  blocks: Block[];
}

const { blocks } = Astro.props;
---

<section class="bg-white" style="border-top: 1px solid var(--color-line);">
  {blocks.map((block, i) => (
    <div class="max-w-[1440px] mx-auto px-gutter py-section">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-center">
        <!-- Image -->
        <div class:list={['relative overflow-hidden', i % 2 === 1 && 'md:order-2']} style="aspect-ratio: 4/3;">
          {block.image ? (
            <Image
              src={block.image}
              alt={block.imageAlt}
              widths={[600, 1000]}
              sizes="(min-width: 768px) 50vw, 100vw"
              loading="lazy"
              class="w-full h-full object-cover"
            />
          ) : (
            <div class="w-full h-full bg-ink" />
          )}
        </div>

        <!-- Text -->
        <div class="md:px-6">
          <h2
            class="font-display text-h2 text-ink mb-8 max-w-[520px]"
            style="font-weight: 400; letter-spacing: var(--tracking-tight);"
          >
            {block.heading}
          </h2>
          <ul class="flex flex-col gap-5 max-w-[520px]">
            {block.bullets.map((b) => (
              <li class="flex gap-4">
                <span
                  aria-hidden="true"
                  class="shrink-0 mt-[9px] w-[6px] h-[6px] rounded-pill bg-gilt"
                />
                <p class="text-[var(--color-ink-70)] text-body leading-relaxed">
                  <strong class="font-semibold text-ink">{b.lead}</strong>{' '}{b.rest}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  ))}
</section>
