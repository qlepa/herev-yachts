---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionLabel from '../ui/SectionLabel.astro';

interface Props {
  images: ImageMetadata[];
  /** Deck titles in layout-NN order; falls back to "<fallbackPrefix> N". */
  titles?: string[];
  fallbackPrefix: string;
  eyebrow: string;
  subtitle: string;
  viewFullSizeLabel: string;
  yachtName: string;
}

const { images, titles = [], fallbackPrefix, eyebrow, subtitle, viewFullSizeLabel, yachtName } = Astro.props;
---

{images.length > 0 && (
  <section id="deck-plans" class="py-section bg-paper">
    <div class="max-w-[1440px] mx-auto px-gutter">

      <SectionLabel text={eyebrow} class="mb-3" />
      <h2 class="font-display text-h2 text-ink mb-10" style="font-weight: 400;">{subtitle}</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {images.map((img, i) => {
          const title = titles[i] ?? `${fallbackPrefix} ${i + 1}`;
          return (
            <div class="bg-white overflow-hidden flex flex-col">
              <p class="font-mono font-bold text-[11px] tracking-[.24em] uppercase text-ink text-center pt-5 pb-3">
                {title}
              </p>
              <a href={img.src} target="_blank" rel="noopener" class="block overflow-hidden px-4" style="aspect-ratio: 16/9;">
                <Image
                  src={img}
                  alt={`${yachtName} — ${title}`}
                  widths={[500, 800]}
                  sizes="(min-width: 768px) 30vw, 90vw"
                  loading="lazy"
                  class="w-full h-full object-contain grayscale contrast-[1.05] opacity-[.82] mix-blend-multiply"
                />
              </a>
              <div class="flex justify-center px-5 py-4 mt-auto border-t border-[var(--color-line)]">
                <a
                  href={img.src}
                  target="_blank"
                  rel="noopener"
                  class="font-mono font-semibold text-[12px] tracking-[.08em] uppercase text-teal hover:text-ink transition-colors"
                >
                  {viewFullSizeLabel}
                </a>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>
)}
