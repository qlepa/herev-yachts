---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  name: string;
  tagline: string;
  href: string;
  image: ImageMetadata | null;
  order: number;
  viewLabel: string;
}

const { name, tagline, href, image, order, viewLabel } = Astro.props;
---

<article class="flex flex-col shadow-card rounded-soft bg-white overflow-hidden">
  <!-- Image block -->
  <a href={href} class="block relative overflow-hidden" style="aspect-ratio: 4/3;">
    {image ? (
      <Image
        src={image}
        alt={name}
        widths={[400, 800]}
        sizes="(min-width: 1024px) 30vw, 90vw"
        loading="lazy"
        class="w-full h-full object-cover transition-transform ease-herev duration-image hover:scale-105"
      />
    ) : (
      <div class="w-full h-full bg-ink" />
    )}

    <!-- Decorative order numeral -->
    <span
      aria-hidden="true"
      class="absolute bottom-3 right-4 font-display text-white/10 leading-none select-none"
      style="font-size: clamp(4rem, 8vw, 6rem); font-weight: 600;"
    >
      {String(order).padStart(2, '0')}
    </span>
  </a>

  <!-- Card body -->
  <div class="flex flex-col flex-1 p-6">
    <a href={href} class="block mb-2">
      <h2 class="font-display text-h3 text-ink hover:text-teal transition-colors" style="font-weight: 400;">
        {name}
      </h2>
    </a>
    <p class="text-body text-[var(--color-ink-70)] leading-relaxed mb-5 flex-1">
      {tagline}
    </p>
    <TextLink href={href}>
      {viewLabel}
    </TextLink>
  </div>
</article>
