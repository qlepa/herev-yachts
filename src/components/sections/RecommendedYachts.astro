---
import type { ImageMetadata } from 'astro';
import FleetCard from '../FleetCard.astro';

interface YachtCardData {
  translationKey: string;
  name: string;
  brandDisplay: string;
  loaM: number;
  loaFt: string;
  priceEur?: number;
  categoryLabel?: string;
  image: ImageMetadata | null;
  href: string;
}

interface Props {
  heading: string;
  yachts: YachtCardData[];
  enquireLabel: string;
  priceOnRequestLabel: string;
  eyebrow?: string;
  viewAllLabel?: string;
  viewAllHref?: string;
}

const { heading, yachts, enquireLabel, priceOnRequestLabel, eyebrow, viewAllLabel, viewAllHref } = Astro.props;
---

{yachts.length > 0 && (
  <section id="recommended" class="py-section bg-paper">
    <div class="max-w-[1440px] mx-auto px-gutter">
      <div class="flex items-end justify-between mb-10 gap-6">
        <div>
          {eyebrow && (
            <p class="font-mono font-bold text-brass text-label tracking-label uppercase mb-3">{eyebrow}</p>
          )}
          <h2 class="font-display text-h2 text-ink" style="font-weight: 400;">
            {heading}
          </h2>
        </div>
        {viewAllLabel && viewAllHref && (
          <a
            href={viewAllHref}
            class="font-mono font-semibold text-[13px] tracking-[.04em] text-ink border-b border-[var(--color-line-strong)] pb-1 hidden md:block whitespace-nowrap hover:text-teal transition-colors"
          >
            {viewAllLabel}
          </a>
        )}
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {yachts.map((yacht) => (
          <FleetCard
            name={yacht.name}
            brandDisplay={yacht.brandDisplay}
            loaM={yacht.loaM}
            loaFt={yacht.loaFt}
            priceEur={yacht.priceEur}
            categoryLabel={yacht.categoryLabel}
            image={yacht.image}
            href={yacht.href}
            enquireLabel={enquireLabel}
            priceOnRequestLabel={priceOnRequestLabel}
          />
        ))}
      </div>
    </div>
  </section>
)}
