---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Btn from '../ui/Btn.astro';
import SectionLabel from '../ui/SectionLabel.astro';

interface Props {
  eyebrow?: string;
  heading?: string;
  subtext?: string;
  specLine?: string;
  cta1Label?: string;
  cta1Href?: string;
  cta2Label?: string;
  cta2Href?: string;
  image: ImageMetadata;
  imageAlt: string;
  videoSrc?: string;
  fullscreen?: boolean;
  muxPlaybackId?: string; // reserved for Step 5 — ignored here
}

const { eyebrow, heading, subtext, specLine, cta1Label, cta1Href, cta2Label, cta2Href, image, imageAlt, videoSrc, fullscreen } =
  Astro.props;
---

{fullscreen ? (
  <section
    class="relative overflow-hidden"
    style="position: sticky; top: 0; z-index: 0; height: 100svh; min-height: 100vh;"
  >
    <Image
      src={image}
      alt={imageAlt}
      widths={[800, 1200, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />

    {videoSrc && (
      <video
        autoplay
        muted
        loop
        playsinline
        class="absolute inset-0 w-full h-full object-cover"
      >
        <source src={videoSrc} type="video/mp4" />
      </video>
    )}

    <div
      class="absolute inset-0 pointer-events-none"
      style="background: linear-gradient(180deg, rgba(15,37,46,.45) 0%, rgba(15,37,46,.10) 40%, rgba(15,37,46,.65) 100%);"
    />

    <div class="hero-reveal relative z-10 h-full flex flex-col justify-end px-gutter pb-14 md:pb-20 max-w-[1440px] mx-auto">
      <h1
        class="font-display text-white mb-8 max-w-[700px] leading-[1.02]"
        style="font-size: clamp(2.75rem, 5.5vw, var(--text-hero)); letter-spacing: var(--tracking-tight); font-weight: 340;"
      >
        {heading}
      </h1>

      <div class="flex flex-wrap gap-3">
        <Btn variant="gilt" href={cta1Href!}>{cta1Label}</Btn>
        <Btn variant="ghost" href={cta2Href!}>{cta2Label}</Btn>
      </div>
    </div>
  </section>
) : (
  <section class="relative overflow-hidden" style="height: clamp(440px, 60vh, 660px);">

    <!-- Background image (LCP + poster fallback) -->
    <Image
      src={image}
      alt={imageAlt}
      widths={[800, 1200, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class={`absolute inset-0 w-full h-full object-cover${videoSrc ? '' : ' hero-kenburns'}`}
    />

    {videoSrc && (
      <video
        autoplay
        muted
        loop
        playsinline
        class="absolute inset-0 w-full h-full object-cover"
      >
        <source src={videoSrc} type="video/mp4" />
      </video>
    )}

    <!-- Gradient overlays -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: linear-gradient(180deg, rgba(15,37,46,.65) 0%, rgba(15,37,46,.20) 45%, rgba(15,37,46,.55) 100%);"
    />

    <!-- Content -->
    <div class="relative z-10 h-full flex flex-col justify-end px-gutter pb-12 md:pb-16 max-w-[1440px] mx-auto">
      <SectionLabel text={eyebrow!} on="ink" class="mb-5" />

      <h1
        class="font-display text-white mb-5 max-w-[680px] leading-[1.02]"
        style="font-size: clamp(2.5rem, 5vw, var(--text-hero)); letter-spacing: var(--tracking-tight); font-weight: 360;"
      >
        {heading}
      </h1>

      {subtext && (
        <p class="text-[var(--color-paper-72)] text-lg leading-relaxed max-w-[540px] mb-8">
          {subtext}
        </p>
      )}

      {specLine ? (
        <div class="flex flex-wrap items-end justify-between gap-4 mt-1">
          <p class="font-mono text-[rgba(255,255,255,.9)] text-[15px] tracking-[.16em] leading-none">
            {specLine}
          </p>
          <div class="flex flex-wrap gap-3">
            <Btn variant="gilt" href={cta1Href!}>{cta1Label}</Btn>
            <Btn variant="ghost" href={cta2Href!}>{cta2Label}</Btn>
          </div>
        </div>
      ) : (
        <div class="flex flex-wrap gap-3">
          <Btn variant="gilt" href={cta1Href!}>{cta1Label}</Btn>
          <Btn variant="ghost" href={cta2Href!}>{cta2Label}</Btn>
        </div>
      )}

      <!-- Waterline ruler -->
      <div class="absolute bottom-0 left-0 right-0 pointer-events-none">
        <svg
          viewBox="0 0 1440 24"
          preserveAspectRatio="none"
          width="100%"
          height="24"
          aria-hidden="true"
        >
          <line x1="0" y1="12" x2="1440" y2="12" stroke="rgba(236,239,238,.35)" stroke-width="1" />
          {Array.from({ length: 9 }).map((_, i) => {
            const x = (i / 8) * 1440;
            const isLong = i % 2 === 0;
            const h = isLong ? 8 : 4;
            const y1 = 12 - h / 2;
            const y2 = 12 + h / 2;
            return (
              <line
                x1={x}
                y1={y1}
                x2={x}
                y2={y2}
                stroke="rgba(236,239,238,.5)"
                stroke-width="1"
              />
            );
          })}
        </svg>
      </div>
    </div>
  </section>
)}

<style is:global>
  @keyframes hero-reveal {
    from { opacity: 0; transform: translateY(1.5rem); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero-reveal {
    animation: hero-reveal 1.4s var(--ease-herev, cubic-bezier(.2,.6,.2,1)) 1.2s both;
  }
</style>

<style>
  @keyframes kenburns {
    from { transform: scale(1); }
    to   { transform: scale(1.08); }
  }
  .hero-kenburns {
    animation: kenburns var(--duration-hero, 9s) var(--ease-herev, ease-out) forwards;
    transform-origin: center center;
  }
</style>
