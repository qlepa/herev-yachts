---
import SectionLabel from '../ui/SectionLabel.astro';

interface Props {
  eyebrow: string;
  heading: string;
  body: string;
}

const { eyebrow, heading, body } = Astro.props;
---

<section class="bg-paper py-section px-gutter overflow-hidden">
  <div class="max-w-[1440px] mx-auto">

    <SectionLabel text={eyebrow} class="mb-10" />

    <h2
      class="font-display text-ink leading-[1.02] mb-12"
      style="font-size: clamp(2.8rem, 6.5vw, 6.5rem); letter-spacing: var(--tracking-tight); font-weight: 340;"
    >
      {heading}
    </h2>

    <div class="flex justify-end">
      <p class="text-[var(--color-ink-70)] text-lg leading-relaxed max-w-[480px]">
        {body}
      </p>
    </div>

  </div>
</section>
