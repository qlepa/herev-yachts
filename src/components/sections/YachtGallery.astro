---
/**
 * Photo gallery with optional category filter — zero JS. Filter buttons are
 * radio labels; `:has()` rules hide non-matching figures. The masonry grid
 * uses `grid-auto-flow: dense` so remaining tiles re-pack after filtering.
 * Filters only appear when at least two categories are present.
 */
import { Image } from 'astro:assets';
import type { GalleryImage } from '../../lib/images';
import { GALLERY_CATEGORIES, type GalleryCategory } from '../../lib/yacht-enums';
import SectionLabel from '../ui/SectionLabel.astro';

interface Props {
  images: GalleryImage[];
  eyebrow: string;
  titlePrefix: string;
  yachtName: string;
  allLabel: string;
  categoryLabels: Record<GalleryCategory, string>;
  imagesLabel: string;
}

const { images, eyebrow, titlePrefix, yachtName, allLabel, categoryLabels, imagesLabel } = Astro.props;

const present = new Set(images.map((i) => i.category));
const categories = GALLERY_CATEGORIES.filter((c) => present.has(c));
const showFilters = categories.length >= 2;

// Desktop masonry pattern (6-col grid, 172px rows), repeated every 5 tiles.
const spans = [
  'md:col-span-4 md:row-span-2',
  'md:col-span-2 md:row-span-2',
  'md:col-span-2 md:row-span-2',
  'md:col-span-2 md:row-span-1',
  'md:col-span-2 md:row-span-1',
];

const css = categories
  .map((c) => `.yacht-gallery:has(#gal-${c}:checked) figure:not([data-cat="${c}"]){display:none}` +
              `.yacht-gallery:has(#gal-${c}:checked) [for="gal-${c}"]{background:var(--color-ink);color:#fff;border-color:var(--color-ink)}`)
  .join('') +
  `.yacht-gallery:has(#gal-all:checked) [for="gal-all"]{background:var(--color-ink);color:#fff;border-color:var(--color-ink)}`;
---

{images.length > 0 && (
  <section id="gallery" class="py-section bg-white">
    <div class="yacht-gallery max-w-[1440px] mx-auto px-gutter">
      {showFilters && <style is:inline set:html={css} />}

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
        <div>
          <SectionLabel text={eyebrow} class="mb-2" />
          <h2 class="font-display text-h2 text-ink" style="font-weight: 400;">
            {titlePrefix} {yachtName}
          </h2>
        </div>

        {showFilters ? (
          <div class="flex flex-wrap gap-2" role="group">
            <input type="radio" name="gallery-filter" id="gal-all" checked class="sr-only" />
            <label for="gal-all" class="gallery-chip">{allLabel}</label>
            {categories.map((c) => (
              <Fragment>
                <input type="radio" name="gallery-filter" id={`gal-${c}`} class="sr-only" />
                <label for={`gal-${c}`} class="gallery-chip">{categoryLabels[c]}</label>
              </Fragment>
            ))}
          </div>
        ) : (
          <p class="font-mono text-label tracking-label text-[var(--color-ink-40)] uppercase hidden md:block">
            {images.length} {imagesLabel}
          </p>
        )}
      </div>

      <div
        class="grid grid-cols-2 gap-3 md:gap-4 md:grid-cols-6 md:[grid-auto-rows:172px] [grid-auto-flow:dense]"
      >
        {images.map((img, i) => (
          <figure
            data-cat={img.category}
            class:list={['overflow-hidden m-0 aspect-square md:aspect-auto', i === 0 && 'col-span-2', spans[i % spans.length]]}
          >
            <Image
              src={img.src}
              alt={`${yachtName} image ${i + 1}`}
              widths={[600, 900, 1200]}
              sizes="(min-width: 768px) 40vw, 100vw"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            />
          </figure>
        ))}
      </div>

    </div>
  </section>
)}

<style>
  .gallery-chip {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-ink-55);
    border: 1px solid var(--color-line-strong);
    padding: 8px 14px;
    cursor: pointer;
    transition: color .2s, background-color .2s, border-color .2s;
  }
  .gallery-chip:hover { color: var(--color-ink); }
  input:focus-visible + .gallery-chip { outline: 2px solid var(--color-teal); outline-offset: 2px; }
</style>
