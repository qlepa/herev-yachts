---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionLabel from '../ui/SectionLabel.astro';

interface Props {
  images: ImageMetadata[];
  eyebrow: string;
  titlePrefix: string;
  yachtName: string;
}

const { images, eyebrow, titlePrefix, yachtName } = Astro.props;
---

{images.length > 0 && (
  <section id="gallery" class="py-section bg-white">
    <div class="max-w-[1440px] mx-auto px-gutter">

      <!-- Header row -->
      <div class="flex items-end justify-between mb-8">
        <div>
          <SectionLabel text={eyebrow} class="mb-2" />
          <h2 class="font-display text-h2 text-ink" style="font-weight: 400;">
            {titlePrefix} {yachtName}
          </h2>
        </div>
        <p class="font-mono text-label tracking-label text-[var(--color-ink-40)] uppercase hidden md:block">
          {images.length} images
        </p>
      </div>

      <!-- Desktop: asymmetric 6-col masonry -->
      <div
        class="hidden md:grid"
        style="grid-template-columns: repeat(6, 1fr); grid-auto-rows: 172px; gap: 16px;"
      >
        {images.map((img, i) => {
          const spans = [
            'col-span-4 row-span-2',
            'col-span-2 row-span-2',
            'col-span-2 row-span-2',
            'col-span-2 row-span-1',
            'col-span-2 row-span-1',
          ];
          const spanClass = spans[i] ?? 'col-span-2 row-span-1';
          return (
            <div class={`overflow-hidden ${spanClass}`}>
              <Image
                src={img}
                alt={`${yachtName} image ${i + 1}`}
                widths={[600, 900, 1200]}
                sizes="(min-width: 1280px) 40vw, 60vw"
                loading="lazy"
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              />
            </div>
          );
        })}
      </div>

      <!-- Mobile: full-width first + 2-col grid for the rest -->
      <div class="md:hidden flex flex-col gap-3">
        {images[0] && (
          <div class="overflow-hidden" style="aspect-ratio: 16/10;">
            <Image
              src={images[0]}
              alt={`${yachtName} image 1`}
              widths={[600, 900]}
              sizes="100vw"
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </div>
        )}
        {images.length > 1 && (
          <div class="grid grid-cols-2 gap-3">
            {images.slice(1).map((img, i) => (
              <div class="overflow-hidden" style="aspect-ratio: 1/1;">
                <Image
                  src={img}
                  alt={`${yachtName} image ${i + 2}`}
                  widths={[400, 600]}
                  sizes="50vw"
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              </div>
            ))}
          </div>
        )}
      </div>

    </div>
  </section>
)}
