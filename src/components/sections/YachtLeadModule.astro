---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionLabel from '../ui/SectionLabel.astro';
import Btn from '../ui/Btn.astro';
import LeadForm from '../../islands/LeadForm.tsx';
import type { Locale } from '../../lib/i18n';
import type { Translations } from '../../lib/i18n-strings';
import { leadFormStrings } from '../../lib/lead-strings';

interface Props {
  lang: Locale;
  t: Translations;
  /** Model page → `yacht` + `yachtKey`; available-now page → `stock` + `stockKey`. */
  source: 'yacht' | 'stock';
  brand: string;
  yachtKey?: string;
  stockKey?: string;
  eyebrow: string;
  heading: string;
  brandLine: string;
  image: ImageMetadata;
  imageAlt: string;
  fallbackContact: string;
  /** Shown read-only in the form and used as the deal title. */
  modelValue: string;
  /** Opt-in shown only when a new unit of this model is in stock. */
  showStockInterest?: boolean;
  /** Optional brochure PDF shown next to the submit button. */
  brochureHref?: string;
  brochureLabel?: string;
}

const {
  lang,
  t,
  source,
  brand,
  yachtKey,
  stockKey,
  eyebrow,
  heading,
  brandLine,
  image,
  imageAlt,
  fallbackContact,
  modelValue,
  showStockInterest,
  brochureHref,
  brochureLabel,
} = Astro.props;
---

<section id="lead" class="bg-ink text-white">
  <div class="max-w-[1440px] mx-auto grid grid-cols-1 md:grid-cols-[2fr_3fr]">

    <!-- Image (left, ~40%) -->
    <div class="relative hidden md:block" style="min-height: 560px;">
      <Image
        src={image}
        alt={imageAlt}
        widths={[600, 900]}
        sizes="40vw"
        loading="lazy"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div
        class="absolute inset-0"
        style="background: linear-gradient(90deg, rgba(15,37,46,0) 55%, rgba(15,37,46,.92) 100%);"
      />
      <div class="absolute left-10 bottom-10 right-10 text-white">
        <div
          class="font-display text-white"
          style="font-size: 26px; font-weight: 340; letter-spacing: .2em; text-indent: .2em;"
        >
          HEREV
        </div>
        <p class="font-mono text-gilt mt-2.5" style="font-size: 10.5px; line-height: 1.8; letter-spacing: .18em;">
          {brandLine}
        </p>
      </div>
    </div>

    <!-- Form (right) -->
    <div class="px-gutter py-14 md:py-20 md:px-[60px]">
      <SectionLabel text={eyebrow} on="ink" class="mb-4" />
      <h2
        class="font-display text-white mb-8"
        style="font-size: clamp(1.5rem, 2.5vw, 2.25rem); font-weight: 400; line-height: 1.1; letter-spacing: -.01em;"
      >
        {heading}
      </h2>

      <!-- Island: submits to /api/lead (shared Zod schema, Turnstile). Below the fold everywhere. -->
      <LeadForm
        client:visible
        variant="yacht"
        context={{ lang, source, brand, yachtKey, stockKey, model: modelValue }}
        strings={leadFormStrings(t, t.yachtPage.sendEnquiry)}
        showFinancing
        showStockInterest={showStockInterest}
        turnstileSiteKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
        fallbackContact={fallbackContact}
      >
        {brochureHref && brochureLabel && (
          <Btn variant="ghost" href={brochureHref} external>{brochureLabel}</Btn>
        )}
      </LeadForm>

      <p class="text-[var(--color-paper-72)] text-micro font-mono tracking-mono mt-5 uppercase">
        <a href={`mailto:${fallbackContact}`} class="underline hover:text-gilt transition-colors">
          {fallbackContact}
        </a>
      </p>
    </div>

  </div>
</section>
