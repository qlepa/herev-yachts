---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionLabel from '../ui/SectionLabel.astro';
import LeadForm from '../../islands/LeadForm.tsx';
import type { Locale } from '../../lib/i18n';
import type { Translations } from '../../lib/i18n-strings';
import type { LeadSource } from '../../lib/lead';
import { leadFormStrings } from '../../lib/lead-strings';

interface Props {
  lang: Locale;
  t: Translations;
  /** Where the enquiry comes from; `brand` routes the deal to the brand's default dealer. */
  source: Exclude<LeadSource, 'yacht' | 'stock' | 'compare'>;
  brand?: string;
  eyebrow: string;
  heading: string;
  subtext: string;
  image: ImageMetadata;
  imageAlt: string;
  callNumber?: string;
  fallbackContact: string;
  models?: string[];
}

const { lang, t, source, brand, eyebrow, heading, subtext, image, imageAlt, callNumber, fallbackContact, models } =
  Astro.props;
---

<section id="lead" class="bg-ink text-white">
  <div class="max-w-[1440px] mx-auto grid grid-cols-1 md:grid-cols-2">

    <!-- Image (left, 42%) -->
    <div class="relative hidden md:block" style="min-height: 560px;">
      <Image
        src={image}
        alt={imageAlt}
        widths={[600, 900]}
        sizes="42vw"
        loading="lazy"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div
        class="absolute inset-0"
        style="background: linear-gradient(90deg, transparent 60%, rgba(15,37,46,.6) 100%);"
      />
    </div>

    <!-- Form (right) -->
    <div class="px-gutter py-14 md:py-20">
      <SectionLabel text={eyebrow} on="ink" class="mb-5" />
      <h2
        class="font-display text-h2 text-white mb-4 max-w-[420px]"
        style="font-weight: 400;"
      >
        {heading}
      </h2>
      <p class="text-[var(--color-paper-72)] text-body leading-relaxed mb-10 max-w-[380px]">
        {subtext}
      </p>

      <!-- Island: submits to /api/lead (shared Zod schema, Turnstile). Below the fold everywhere. -->
      <LeadForm
        client:visible
        variant="compact"
        context={{ lang, source, brand }}
        strings={leadFormStrings(t)}
        models={models}
        turnstileSiteKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
        fallbackContact={fallbackContact}
      />

      <p class="text-[var(--color-paper-72)] text-micro font-mono tracking-mono mt-4 text-center uppercase">
        <a href={`mailto:${fallbackContact}`} class="underline hover:text-gilt transition-colors">
          {fallbackContact}
        </a>
        {callNumber && (
          <>
            {' '}· {t.lead.orCall}{' '}
            <a href={`tel:${callNumber.replace(/\s/g, '')}`} class="underline hover:text-gilt transition-colors">
              {callNumber}
            </a>
          </>
        )}
      </p>
    </div>

  </div>
</section>
