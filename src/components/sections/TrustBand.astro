---
interface Props {
  brandNames: string[];
  awardsLine?: string;
}

const { brandNames, awardsLine } = Astro.props;
---

<section class="bg-ink py-10">
  <div class="max-w-[1440px] mx-auto px-gutter">

    <div class="flex flex-wrap items-center justify-center">
      {brandNames.map((name, i) => (
        <span
          class="font-display"
          style={`font-weight: 380; font-size: 22px; letter-spacing: .18em; padding: 0 34px; color: rgba(236,239,238,.9);${i < brandNames.length - 1 ? ' border-right: 1px solid rgba(236,239,238,.16);' : ''}`}
        >
          {name}
        </span>
      ))}
    </div>

    {awardsLine && (
      <p
        class="font-mono text-gilt text-center uppercase mt-[26px]"
        style="font-size: 10.5px; letter-spacing: .26em; line-height: 1.8;"
      >
        {awardsLine}
      </p>
    )}

  </div>
</section>
