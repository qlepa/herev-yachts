---
interface Props {
  brandNames: string[];
  awardsLine?: string;
}

const { brandNames, awardsLine } = Astro.props;

const logoMap: Record<string, string> = {
  'GALEON':      '/partners/GaleonYachts_Logo_Black-scaled.webp',
  'SAXDOR':      '/partners/saxdor-yachts.webp',
  'DE ANTONIO':  '/partners/DE-ANTONIO-YACHTS_LOGO-scaled.webp',
  'CHRIS-CRAFT': '/partners/chris-craft-boats.svg',
};
---

<section class="bg-ink py-10">
  <div class="max-w-[1440px] mx-auto px-gutter">

    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
      {brandNames.map((name, i) => {
        const logo = logoMap[name];
        return (
          <>
            {logo ? (
              <img
                src={logo}
                alt={name}
                height="32"
                class="h-8 w-auto select-none opacity-70"
                style="filter: brightness(0) invert(1);"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span
                class="font-display text-white uppercase tracking-[.16em] select-none opacity-70"
                style="font-size: 17px; font-weight: 380;"
              >
                {name}
              </span>
            )}
            {i < brandNames.length - 1 && (
              <span class="text-[var(--color-line-on-ink)] font-mono text-[18px] opacity-30">·</span>
            )}
          </>
        );
      })}
    </div>

    {awardsLine && (
      <p class="font-mono text-micro tracking-mono text-center text-[var(--color-paper-72)] opacity-50 mt-6 uppercase">
        {awardsLine}
      </p>
    )}

  </div>
</section>
