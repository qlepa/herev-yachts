---
interface Props {
  loaM: number;
  minM?: number;
  maxM?: number;
  class?: string;
}

const { loaM, minM = 8, maxM = 16, class: cls } = Astro.props;
const pct = Math.min(100, Math.max(0, ((loaM - minM) / (maxM - minM)) * 100));
---

<div class:list={['flex items-center gap-3', cls]}>
  <span class="font-mono font-bold text-[10px] tracking-mono text-[var(--color-ink-55)] w-11 shrink-0">
    {loaM.toFixed(2)} M
  </span>
  <div
    class="flex-1 h-[3px] rounded-none relative"
    style="background: var(--color-line);"
  >
    <div
      class="absolute inset-y-0 left-0 bg-brass rounded-none"
      style={`width: ${pct.toFixed(2)}%`}
    />
  </div>
</div>
