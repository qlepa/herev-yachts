---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { cmsImageSrcset, type CmsImageData } from '../../lib/sanityImage';

/**
 * Image from the repo (ImageMetadata) or from the CMS. CMS images go
 * through astro:assets in the production build (fetched from Sanity once,
 * served from Vercel); on the CMS deployment, where pages render per
 * request, they load straight from the Sanity CDN.
 */
interface Props {
  src: ImageMetadata | CmsImageData;
  /** Alt for repo images; CMS images carry their own. */
  alt?: string;
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

// `rest` carries the parent's scoped-style attribute (data-astro-cid-*).
const { src, alt = '', widths, sizes, loading = 'lazy', fetchpriority, class: className, ...rest } = Astro.props;
const cms = 'url' in src ? src : undefined;
const style = cms?.objectPosition ? `object-position: ${cms.objectPosition}` : undefined;
---

{!cms ? (
  <Image src={src as ImageMetadata} alt={alt} widths={widths} sizes={sizes} loading={loading} fetchpriority={fetchpriority} {...rest} class={className} />
) : !cms.url ? (
  <div {...rest} class={`bg-ink ${className ?? ''}`} data-sanity={cms.dataSanity} />
) : Astro.isPrerendered ? (
  <Image
    src={cms.url}
    alt={cms.alt}
    width={cms.width}
    height={cms.height}
    widths={widths}
    sizes={sizes}
    loading={loading}
    fetchpriority={fetchpriority}
    {...rest}
    class={className}
    style={style}
  />
) : (
  <img
    src={cmsImageSrcset(cms.url, [widths[widths.length - 1]]).split(' ')[0]}
    srcset={cmsImageSrcset(cms.url, widths)}
    sizes={sizes}
    alt={cms.alt}
    width={cms.width}
    height={cms.height}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    {...rest}
    class={className}
    style={style}
    data-sanity={cms.dataSanity}
  />
)}
