---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Btn from './ui/Btn.astro';
import TextLink from './ui/TextLink.astro';

interface Props {
  name: string;
  brandDisplay: string;
  year: number;
  priceLabel: string;
  taxLabel: string;
  image: ImageMetadata | null;
  href: string;
  enquireLabel: string;
  moreInfoLabel: string;
}

const { name, brandDisplay, year, priceLabel, taxLabel, image, href, enquireLabel, moreInfoLabel } =
  Astro.props;
---

<article class="flex flex-col shadow-card bg-white w-full min-w-0">
  <a href={href} class="block relative overflow-hidden" style="aspect-ratio: 16/10;">
    {image ? (
      <Image
        src={image}
        alt={`${brandDisplay} ${name}`}
        widths={[400, 800]}
        sizes="(min-width: 768px) 33vw, 100vw"
        loading="lazy"
        class="w-full h-full object-cover transition-transform ease-herev duration-image hover:scale-105"
      />
    ) : (
      <div class="w-full h-full bg-ink" />
    )}
    <span
      class="absolute top-3 left-3 font-mono font-bold text-white uppercase"
      style="font-size: 9.5px; letter-spacing: .2em; text-shadow: 0 1px 4px rgba(15,37,46,.6);"
    >
      {brandDisplay} · {year}
    </span>
  </a>

  <div class="flex flex-col flex-1 p-[22px]">
    <a href={href} class="block">
      <h3 class="font-display text-title text-ink mb-1 hover:text-teal transition-colors" style="font-weight: 450;">
        {brandDisplay} {name}
      </h3>
    </a>

    <p class="font-mono text-[12px] tracking-mono text-[var(--color-ink-70)] uppercase mb-6">
      {priceLabel} {taxLabel}
    </p>

    <div
      class="flex items-center justify-between gap-4 pt-4 mt-auto"
      style="border-top: 1px solid var(--color-line);"
    >
      <Btn variant="outline" href={`${href}#lead`}>{enquireLabel}</Btn>
      <TextLink href={href}>{moreInfoLabel}</TextLink>
    </div>
  </div>
</article>
