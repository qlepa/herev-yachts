---
import type { Locale } from '../lib/i18n';
import type { Translations } from '../lib/i18n-strings';

interface Props {
  lang: Locale;
  t: Translations['footer'];
}

const { lang, t } = Astro.props;
---

<footer class="bg-ink text-white">
  <div class="max-w-[1440px] mx-auto px-gutter py-8 border-t border-[var(--color-line-on-ink)]">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-4 font-mono text-micro tracking-mono text-[var(--color-paper-72)] uppercase">
        <span>GALEON</span>
        <span class="opacity-30">·</span>
        <span>PARKER</span>
        <span class="opacity-30">·</span>
        <span>SAXDOR</span>
        <span class="opacity-30">·</span>
        <span>DE ANTONIO</span>
        <span class="opacity-30">·</span>
        <span>CHRIS-CRAFT</span>
      </div>
      <p class="font-mono text-micro tracking-mono text-[var(--color-paper-72)] opacity-50">
        {t.legal}
      </p>
    </div>
  </div>
</footer>
