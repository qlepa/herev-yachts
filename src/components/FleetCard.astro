---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import WaterlineBar from './ui/WaterlineBar.astro';
import TextLink from './ui/TextLink.astro';

interface Props {
  name: string;
  brandDisplay: string;
  loaM: number;
  loaFt: string;
  categoryLabel?: string;
  image: ImageMetadata | null;
  href: string;
  enquireLabel: string;
}

const {
  name,
  brandDisplay,
  loaM,
  categoryLabel,
  image,
  href,
  enquireLabel,
} = Astro.props;
---

<article
  class="flex flex-col shadow-card bg-white rounded-none w-full min-w-[260px] max-w-[340px] shrink-0"
>
  <!-- Image block -->
  <a href={href} class="block relative overflow-hidden" style="aspect-ratio: 4/3.2;">
    {image ? (
      <Image
        src={image}
        alt={name}
        widths={[300, 600]}
        sizes="(min-width: 1024px) 20vw, 50vw"
        loading="lazy"
        class="w-full h-full object-cover transition-transform ease-herev duration-image hover:scale-105"
      />
    ) : (
      <div class="w-full h-full bg-ink" />
    )}

    <!-- Brand tag -->
    <span
      class="absolute top-3 left-3 font-mono font-bold text-white uppercase"
      style="font-size: 9.5px; letter-spacing: .2em; text-shadow: 0 1px 4px rgba(15,37,46,.6);"
    >
      {brandDisplay}
    </span>
  </a>

  <!-- Card body -->
  <div class="flex flex-col flex-1 p-[18px]">
    <a href={href} class="block">
      <h3 class="font-display text-title mb-1 hover:text-teal transition-colors" style="font-weight: 450;">
        {name}
      </h3>
    </a>

    {categoryLabel && (
      <p class="font-mono text-[10.5px] tracking-mono text-teal mb-4 uppercase">
        {categoryLabel}
      </p>
    )}

    <WaterlineBar loaM={loaM} class="mb-4" />

    <!-- Footer -->
    <div
      class="flex items-center justify-end pt-3 mt-auto"
      style="border-top: 1px solid var(--color-line);"
    >
      <TextLink href={`${href}#lead`}>
        {enquireLabel}
      </TextLink>
    </div>
  </div>
</article>
