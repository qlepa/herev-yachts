---
import type { Locale } from '../lib/i18n';
import { LOCALES } from '../lib/i18n';
import type { NavStrings } from '../lib/i18n-strings';
import Btn from './ui/Btn.astro';

interface Props {
  lang: Locale;
  variant: 'transparent' | 'ink';
  currentPath: string;
  nav: NavStrings;
}

const { lang, variant, currentPath, nav } = Astro.props;

function localePath(target: Locale): string {
  if (currentPath.startsWith(`/${lang}/`)) {
    return currentPath.replace(`/${lang}/`, `/${target}/`);
  }
  return `/${target}/`;
}

const headerClass =
  variant === 'transparent'
    ? 'fixed top-0 left-0 right-0 z-[60] text-white'
    : 'sticky top-0 z-[60] bg-ink text-white shadow-panel';

const navLinks = [
  { label: nav.yachts,   href: `/${lang}/yachts/` },
  { label: nav.brands,   href: `/${lang}/brands/` },
  { label: nav.services, href: `/${lang}/services/` },
  { label: nav.network,  href: `/${lang}/network/` },
  { label: nav.blog,     href: `/${lang}/blog/` },
];

const langLabels: Record<Locale, string> = {
  en: 'EN', pl: 'PL', es: 'ES', it: 'IT',
};
---

<header class={headerClass} data-scroll-header={variant === 'transparent' ? '' : undefined}>
  <div class="max-w-[1440px] mx-auto px-gutter flex items-center justify-between h-[72px]">

    <!-- Wordmark -->
    <a
      href={`/${lang}/`}
      class="font-display text-[22px] tracking-wordmark uppercase font-light leading-none shrink-0"
      style="font-weight: 340;"
    >
      HEREV
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-7" aria-label="Main navigation">
      {navLinks.map(({ label, href }) => (
        <a
          href={href}
          class:list={[
            'font-body text-sm font-medium transition-opacity hover:opacity-70',
            currentPath === href ? 'opacity-100' : 'opacity-80',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- Desktop: lang switcher + CTA -->
    <div class="hidden md:flex items-center gap-6 shrink-0">
      <div class="flex items-center gap-[6px] font-mono text-micro tracking-mono opacity-60">
        {LOCALES.map((l, i) => (
          <>
            <a
              href={localePath(l)}
              class:list={[
                'hover:opacity-100 transition-opacity',
                l === lang ? 'opacity-100 font-bold' : 'opacity-60',
              ]}
            >
              {langLabels[l]}
            </a>
            {i < LOCALES.length - 1 && <span class="opacity-30">·</span>}
          </>
        ))}
      </div>
      <Btn variant="gilt" href={`/${lang}/#lead`}>
        {nav.enquire}
      </Btn>
    </div>

    <!-- Mobile: hamburger button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden w-10 h-10 flex flex-col justify-center items-center gap-[6px] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white/50 rounded"
      aria-label="Open navigation"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="hamburger-line block w-6 h-px bg-current"></span>
      <span class="hamburger-line block w-6 h-px bg-current"></span>
      <span class="hamburger-line block w-6 h-px bg-current"></span>
    </button>

  </div>
</header>

<!-- Mobile menu overlay — outside header so z-index stacking is independent -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-50 bg-ink text-white flex flex-col md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
  aria-hidden="true"
>
  <!-- Spacer matching header height -->
  <div class="h-[72px] shrink-0 border-b border-[var(--color-line-on-ink)]"></div>

  <!-- Nav links -->
  <nav class="flex flex-col flex-1 overflow-y-auto px-gutter pt-6" aria-label="Mobile navigation">
    {navLinks.map(({ label, href }, i) => (
      <a
        href={href}
        class:list={[
          'mobile-nav-link font-display text-[2.25rem] leading-none py-5 border-b border-[var(--color-line-on-ink)]',
          currentPath === href ? 'text-gilt' : 'text-white',
        ]}
        style={`--delay: ${i * 55}ms`}
      >
        {label}
      </a>
    ))}

    <a
      href={`/${lang}/#lead`}
      class="mobile-nav-link mt-8 self-start font-body text-xs font-semibold tracking-[0.18em] uppercase text-gilt"
      style={`--delay: ${navLinks.length * 55 + 40}ms`}
    >
      {nav.enquire} →
    </a>
  </nav>

  <!-- Language switcher -->
  <div class="px-gutter pb-10 pt-6 flex items-center gap-4 font-mono text-micro tracking-mono border-t border-[var(--color-line-on-ink)]">
    {LOCALES.map((l, i) => (
      <>
        <a
          href={localePath(l)}
          class:list={[
            'transition-opacity hover:opacity-100',
            l === lang ? 'text-gilt opacity-100 font-bold' : 'text-white opacity-40',
          ]}
        >
          {langLabels[l]}
        </a>
        {i < LOCALES.length - 1 && <span class="text-white opacity-20">·</span>}
      </>
    ))}
  </div>
</div>

<style>
  /* ── Scroll-based header background (transparent variant) ── */
  [data-scroll-header] {
    transition: background-color 0.25s ease, box-shadow 0.25s ease;
  }
  [data-scroll-header].scrolled {
    background-color: var(--color-ink);
    box-shadow: var(--shadow-panel);
  }

  /* ── Hamburger → X morphing ── */
  #mobile-menu-btn .hamburger-line {
    transition: transform 0.3s ease, opacity 0.2s ease;
    transform-origin: center;
  }
  #mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Overlay slide-in ── */
  #mobile-menu {
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    visibility: hidden;
  }
  #mobile-menu.is-open {
    transform: translateX(0);
    visibility: visible;
  }

  /* ── Staggered link entrance ── */
  .mobile-nav-link {
    opacity: 0;
    transform: translateX(1.5rem);
    transition:
      opacity 0.3s ease var(--delay, 0ms),
      transform 0.3s ease var(--delay, 0ms);
  }
  #mobile-menu.is-open .mobile-nav-link {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    const open = () => {
      menu.classList.add('is-open');
      menu.setAttribute('aria-hidden', 'false');
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Close navigation');
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      menu.classList.remove('is-open');
      menu.setAttribute('aria-hidden', 'true');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Open navigation');
      document.body.style.overflow = '';
    };

    btn.addEventListener('click', () => {
      btn.getAttribute('aria-expanded') === 'true' ? close() : open();
    });

    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        close();
        btn.focus();
      }
    });
  }

  // Scroll-based header bg
  const h = document.querySelector<HTMLElement>('[data-scroll-header]');
  if (h) {
    const toggle = () => h.classList.toggle('scrolled', window.scrollY > 0);
    window.addEventListener('scroll', toggle, { passive: true });
    toggle();
  }
</script>
