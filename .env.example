# Sanity (build + CMS deployment)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# true only on the CMS deployment (Studio + draft preview)
SANITY_PREVIEW=false

# Site
PUBLIC_INDEXING_ENABLED=false
PUBLIC_MAPBOX_TOKEN=

# Lead endpoint (/api/lead) — docs/kontrakt-api-lead.md
# Cloudflare Turnstile; test keys that always pass: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PIPEDRIVE_API_TOKEN=
RESEND_API_KEY=
# Verified sender, e.g. "Herev <leads@herev.com>"
LEAD_FROM_EMAIL=
# Used only when the Sanity "Odbiorcy powiadomień" list is empty
LEAD_FALLBACK_EMAIL=
